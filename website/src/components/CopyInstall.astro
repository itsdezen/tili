---
import { site } from '../lib/site'

const command = site.installCommand
---

<div class="copy-install">
  <code>{command}</code>
  <button
    class="copy-install-button"
    type="button"
    data-copy-command={command}
    aria-label="Copy install command"
  >
    <span data-copy-label aria-live="polite">
      Copy
    </span>
  </button>
</div>

<script is:inline data-enhancement="copy-install">
  document.querySelectorAll('[data-copy-command]').forEach(function (button) {
    button.addEventListener('click', function () {
      const command = button.getAttribute('data-copy-command') || ''
      const label = button.querySelector('[data-copy-label]')

      navigator.clipboard.writeText(command).then(function () {
        if (!label) return
        label.textContent = 'Copied'
        window.setTimeout(function () {
          label.textContent = 'Copy'
        }, 1500)
      })
    })
  })
</script>
