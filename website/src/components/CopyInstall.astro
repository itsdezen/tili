---
const command = 'brew install itsdezen/tap/tili';
---

<div class="copy-install">
  <code>{command}</code>
  <button id="copy-install-btn" type="button" aria-label="Copy install command" data-command={command}>
    <svg class="icon icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="9" y="9" width="13" height="13" rx="2"></rect>
      <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
    </svg>
    <svg class="icon icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </button>
</div>

<style>
  .copy-install {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    border-radius: 0.5rem;
    padding: clamp(0.4rem, 1.2vw, 0.6rem) clamp(0.5rem, 1.5vw, 0.75rem);
    max-width: 100%;
  }

  code {
    font-family: var(--font-sans);
    font-size: clamp(0.75rem, 1.6vw, 0.9rem);
    color: var(--color-fg);
    white-space: nowrap;
    overflow-x: auto;
  }

  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.35rem;
    border: none;
    background: transparent;
    color: var(--color-fg-muted);
    cursor: pointer;
  }

  button:hover {
    color: var(--color-fg);
  }

  .icon {
    width: 1rem;
    height: 1rem;
  }

  .icon-check {
    display: none;
    color: var(--color-fg);
  }

  button.copied .icon-copy {
    display: none;
  }

  button.copied .icon-check {
    display: block;
  }
</style>

<script>
  const button = document.getElementById('copy-install-btn');

  button?.addEventListener('click', async () => {
    const command = button.getAttribute('data-command') ?? '';
    await navigator.clipboard.writeText(command);
    button.classList.add('copied');
    setTimeout(() => button.classList.remove('copied'), 1500);
  });
</script>
