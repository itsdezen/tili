---
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import StatusBar from '../components/StatusBar.astro'
import {
  absoluteUrl,
  pageTitle,
  seo,
  websiteJsonLd,
  type JsonLd,
} from '../lib/seo'
import '../styles/global.css'

interface Props {
  title: string
  description: string
  path: string
  statusLeft: string
  statusRight?: { label: string; href: string }
  wide?: boolean
  noIndex?: boolean
  search?: boolean
  searchable?: boolean
  jsonLd?: JsonLd | Array<JsonLd>
}

const {
  title,
  description,
  path,
  statusLeft,
  statusRight,
  wide = false,
  noIndex = false,
  search = false,
  searchable = false,
  jsonLd,
} = Astro.props

const canonical = absoluteUrl(path)
const fullTitle = pageTitle(title)
const imageUrl = absoluteUrl(seo.defaultImage)
const imageAlt = seo.title
const structuredData = [
  websiteJsonLd(),
  ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : []),
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noIndex ? 'noindex, nofollow' : 'index, follow'}
    />
    <meta name="theme-color" content={seo.themeColor} />
    <meta name="apple-mobile-web-app-title" content={seo.siteName} />
    {!noIndex && <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="mask-icon" href="/favicon-mask.svg" color="#171512" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={searchable ? 'article' : 'website'} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={seo.siteName} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <slot name="head" />
  </head>
  <body data-pagefind-ignore={searchable ? undefined : true}>
    <a class="skip-link" href="#main-content">
      Skip to content
    </a>
    <div class:list={['window', wide && 'window--wide']}>
      <SiteHeader path={path} search={search} />
      <main id="main-content" class="window-main">
        <slot />
      </main>
      <StatusBar left={statusLeft} right={statusRight} />
    </div>
    <SiteFooter />
  </body>
</html>
