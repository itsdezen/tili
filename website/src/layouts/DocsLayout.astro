---
import { getCollection } from 'astro:content'
import DocsNav from '../components/DocsNav.astro'
import DocsSearch from '../components/DocsSearch.astro'
import Base from './Base.astro'
import { docNeighbors, docPath, sortDocs, type DocEntry } from '../lib/docs'
import { breadcrumbJsonLd, techArticleJsonLd } from '../lib/seo'
import { site } from '../lib/site'
import '../styles/docs.css'

interface Props {
  entry: DocEntry
}

const { entry } = Astro.props
const docs = sortDocs(await getCollection('docs'))
const path = docPath(entry.id)
const { previous, next } = docNeighbors(docs, entry.id)

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Docs', path: '/docs' },
  ...(entry.id === 'index' ? [] : [{ name: entry.data.title, path }]),
]

const elsewhere = [
  { label: 'Releases', href: site.releases },
  { label: 'Source on GitHub', href: site.repository },
  { label: 'Sponsor', href: site.sponsor },
]
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  wide
  search
  searchable
  statusLeft={`Docs · ${entry.data.title}`}
  statusRight={{ label: 'github.com/itsdezen/tili', href: site.repository }}
  jsonLd={[
    techArticleJsonLd({
      title: entry.data.title,
      description: entry.data.description,
      path,
    }),
    breadcrumbJsonLd(crumbs),
  ]}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script
      is:inline
      src="/pagefind/pagefind-component-ui.js"
      type="module"
    ></script>
  </Fragment>

  <div class="docs">
    <aside class="docs-sidebar" data-pagefind-ignore>
      <p class="docs-sidebar-title">Documentation</p>
      <DocsNav items={docs} current={entry.id} />
      <p class="docs-sidebar-title docs-nav-external">Elsewhere</p>
      <ul class="docs-nav">
        {elsewhere.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span aria-hidden="true"> ↗</span>
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <details class="docs-mobile-nav" data-pagefind-ignore>
      <summary>Documentation menu</summary>
      <DocsNav items={docs} current={entry.id} />
    </details>

    <article class="prose" data-pagefind-body>
      <header class="docs-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          {crumbs.map((crumb) =>
            crumb.path === path ? (
              <span aria-current="page">{crumb.name}</span>
            ) : (
              <a href={crumb.path}>{crumb.name}</a>
            ),
          )}
        </nav>
        <h1 class="page-title">{entry.data.title}</h1>
        <p class="page-lede">{entry.data.description}</p>
      </header>

      <slot />

      <nav class="docs-pager" aria-label="Docs pagination" data-pagefind-ignore>
        {previous ? (
          <a href={docPath(previous.id)} rel="prev">
            ← {previous.data.title}
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}
        {next ? (
          <a href={docPath(next.id)} rel="next">
            {next.data.title} →
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}
      </nav>
    </article>
  </div>

  <DocsSearch />
</Base>
