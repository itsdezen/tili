---
import { getCollection } from 'astro:content'
import DocsNav from '../components/DocsNav.astro'
import DocsSearch from '../components/DocsSearch.astro'
import DocsToc from '../components/DocsToc.astro'
import Base from './Base.astro'
import { docNeighbors, docPath, sortDocs, type DocEntry } from '../lib/docs'
import { breadcrumbJsonLd, techArticleJsonLd } from '../lib/seo'
import { site } from '../lib/site'
import '../styles/docs.css'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  entry: DocEntry
  headings: Array<Heading>
}

const { entry, headings } = Astro.props
const docs = sortDocs(await getCollection('docs'))
const path = docPath(entry.id)
const { previous, next } = docNeighbors(docs, entry.id)

// Two groups read better than eight flat rows: orientation first, reference
// second. The split follows the published order rather than a second list.
const startHere = docs.slice(0, 4)
const reference = docs.slice(4)

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Docs', path: '/docs' },
  ...(entry.id === 'index' ? [] : [{ name: entry.data.title, path }]),
]

const elsewhere = [
  { label: 'Releases', href: site.releases },
  { label: 'Source on GitHub', href: site.repository },
  { label: 'Sponsor', href: site.sponsor },
]

const sourceUrl = `${site.repository}/edit/main/website/src/content/docs/${entry.id}.md`
const issueUrl = `${site.repository}/issues/new?title=${encodeURIComponent(
  `Docs: ${entry.data.title}`,
)}`
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  path={path}
  wide
  search
  searchable
  statusLeft={`Docs · ${entry.data.title}`}
  statusRight={{ label: 'github.com/itsdezen/tili', href: site.repository }}
  jsonLd={[
    techArticleJsonLd({
      title: entry.data.title,
      description: entry.data.description,
      path,
    }),
    breadcrumbJsonLd(crumbs),
  ]}
>
  <Fragment slot="head">
    <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
    <script
      is:inline
      src="/pagefind/pagefind-component-ui.js"
      type="module"
    ></script>
  </Fragment>

  <div class="docs">
    <aside class="docs-sidebar" data-pagefind-ignore>
      <p class="docs-sidebar-title">Start here</p>
      <DocsNav items={startHere} current={entry.id} />
      <p class="docs-sidebar-title docs-nav-group">Reference</p>
      <DocsNav items={reference} current={entry.id} />
      <p class="docs-sidebar-title docs-nav-group">Elsewhere</p>
      <ul class="docs-nav">
        {elsewhere.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener noreferrer">
              {link.label}
              <span aria-hidden="true"> ↗</span>
              <span class="sr-only"> (opens in new tab)</span>
            </a>
          </li>
        ))}
      </ul>
    </aside>

    <details class="docs-mobile-nav" data-pagefind-ignore>
      <summary>Documentation menu</summary>
      <p class="docs-sidebar-title">Start here</p>
      <DocsNav items={startHere} current={entry.id} />
      <p class="docs-sidebar-title docs-nav-group">Reference</p>
      <DocsNav items={reference} current={entry.id} />
    </details>

    <article class="prose" data-pagefind-body>
      <header class="docs-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          {crumbs.map((crumb) =>
            crumb.path === path ? (
              <span aria-current="page">{crumb.name}</span>
            ) : (
              <a href={crumb.path}>{crumb.name}</a>
            ),
          )}
        </nav>
        <h1 class="page-title">{entry.data.title}</h1>
        <p class="page-lede">{entry.data.description}</p>
      </header>

      <DocsToc headings={headings} />

      <slot />

      <p class="docs-meta" data-pagefind-ignore>
        <a href={sourceUrl} target="_blank" rel="noopener noreferrer">
          Edit this page on GitHub
          <span class="sr-only"> (opens in new tab)</span>
        </a>
        <a href={issueUrl} target="_blank" rel="noopener noreferrer">
          Report a docs issue<span class="sr-only"> (opens in new tab)</span>
        </a>
      </p>

      <nav class="docs-pager" aria-label="Docs pagination" data-pagefind-ignore>
        {previous ? (
          <a href={docPath(previous.id)} rel="prev">
            ← {previous.data.title}
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}
        {next ? (
          <a href={docPath(next.id)} rel="next">
            {next.data.title} →
          </a>
        ) : (
          <span aria-hidden="true"></span>
        )}
      </nav>
    </article>
  </div>

  <DocsSearch />

  {/* Progressive enhancement: works without it, since every code block is
      still plain selectable text when this never runs. */}
  <script is:inline data-enhancement="copy-code">
    document.querySelectorAll('.prose pre').forEach(function (pre) {
      if (!pre.parentElement) return
      if (pre.parentElement.classList.contains('code-block')) return

      const wrapper = document.createElement('div')
      wrapper.className = 'code-block'
      pre.parentNode.insertBefore(wrapper, pre)
      wrapper.appendChild(pre)

      const button = document.createElement('button')
      button.type = 'button'
      button.className = 'code-copy'
      button.textContent = 'Copy'
      button.setAttribute('aria-label', 'Copy code block')
      button.addEventListener('click', function () {
        const text = (pre.textContent || '').replace(/\n$/, '')
        const combo = /Mac|iPhone|iPad/.test(navigator.platform || '')
          ? '⌘C'
          : 'Ctrl+C'

        navigator.clipboard.writeText(text).then(
          function () {
            button.textContent = 'Copied'
            window.setTimeout(function () {
              button.textContent = 'Copy'
            }, 1500)
          },
          function () {
            // Clipboard permission denied: select the block so the shortcut
            // the label names can finish the job.
            const selection = window.getSelection()
            const range = document.createRange()
            range.selectNodeContents(pre)
            if (selection) {
              selection.removeAllRanges()
              selection.addRange(range)
            }
            button.textContent = 'Press ' + combo
            window.setTimeout(function () {
              button.textContent = 'Copy'
            }, 2500)
          },
        )
      })

      wrapper.appendChild(button)
    })
  </script>
</Base>
