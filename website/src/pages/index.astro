---
import { getCollection } from 'astro:content'
import CopyInstall from '../components/CopyInstall.astro'
import Base from '../layouts/Base.astro'
import { docPath, sortDocs } from '../lib/docs'
import { faqJsonLd, softwareApplicationJsonLd } from '../lib/seo'
import { faq, features, installSteps, site } from '../lib/site'

const docs = sortDocs(await getCollection('docs')).filter(
  (entry) => entry.id !== 'index',
)
---

<Base
  title={site.title}
  description={site.description}
  path="/"
  statusLeft="MIT licensed · Rust · public Accessibility API only"
  statusRight={{ label: 'github.com/itsdezen/tili', href: site.repository }}
  jsonLd={[softwareApplicationJsonLd(), faqJsonLd()]}
>
  <div class="landing">
    <header class="page-header">
      <p class="page-kicker">macOS · Rust · MIT</p>
      <h1 class="page-title">tili — a tiling window manager for macOS</h1>
      <p class="page-lede">
        tili is an i3-style tiling window manager for macOS, built for speed. It
        reacts to Accessibility notifications, stays on the public Accessibility
        API, and never asks you to disable System Integrity Protection.
      </p>
      <div class="hero-actions">
        <CopyInstall />
        <a class="button" href="/docs">
          Read the docs
        </a>
        <a
          class="button"
          href={site.releases}
          target="_blank"
          rel="noopener noreferrer"
        >
          Releases<span aria-hidden="true"> ↗</span>
          <span class="sr-only"> (opens in new tab)</span>
        </a>
      </div>
    </header>

    <section class="landing-section" aria-labelledby="why-tili">
      <h2 id="why-tili">Why tili</h2>
      <p>
        Most tiling window managers for macOS make you choose between polling
        the screen and reaching for private APIs that break on the next system
        update. tili takes neither shortcut: it waits for Accessibility
        notifications, and everything except one narrow <code>CGWindowID</code>
        lookup is public API.
      </p>
      <dl class="feature-list">
        {features.map((feature) => (
          <div class="feature">
            <dt>{feature.title}</dt>
            <dd>{feature.text}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="landing-section" aria-labelledby="install">
      <h2 id="install">Install</h2>
      <p>
        Install the signed app with Homebrew, then start the daemon. It
        registers a LaunchAgent, so tili comes back after a reboot.
      </p>
      <ol class="install-steps">
        {installSteps.map((step) => (
          <li>
            <code>{step.command}</code>
            <span>{step.text}</span>
          </li>
        ))}
      </ol>
      <p class="install-note">
        The first run asks for <strong>Accessibility</strong> and
        <strong>Input Monitoring</strong> permission. tili waits for both and
        starts as soon as you grant them. See
        <a href="/docs/getting-started">Getting Started</a> for permissions,
        troubleshooting, and building from source.
      </p>
    </section>

    <section class="landing-section" aria-labelledby="documentation">
      <h2 id="documentation">Documentation</h2>
      <p>
        Everything from the first install to the Accessibility boundary is
        documented, with the full configuration and command reference.
      </p>
      <ul class="rows">
        {docs.map((entry) => (
          <li>
            <a href={docPath(entry.id)}>
              <span class="title">{entry.data.title}</span>
              <span class="arrow" aria-hidden="true">
                →
              </span>
              <span class="desc">{entry.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="landing-section" aria-labelledby="faq">
      <h2 id="faq">Frequently asked questions</h2>
      <dl class="faq-list">
        {faq.map((item) => (
          <div class="faq-item">
            <dt>{item.question}</dt>
            <dd>{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</Base>
